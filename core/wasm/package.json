{
  "name": "@aureline/wasm",
  "version": "0.0.0",
  "type": "module",
  "description": "Browser WebAssembly wrapper for Aureline lexer details.",
  "license": "MIT OR Apache-2.0",
  "main": "./dist/aureline_wasm.js",
  "types": "./dist/aureline_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/aureline_wasm.d.ts",
      "default": "./dist/aureline_wasm.js"
